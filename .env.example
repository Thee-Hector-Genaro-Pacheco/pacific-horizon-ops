# Anthropic API credentials
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5

# Gmail Profile Selector (options: business, personal; defaults to "business" if unset)
PHRO_GMAIL_PROFILE=business

# Expected Gmail Account Binding (Optional safety guard: normalised email address)
PHRO_GMAIL_BUSINESS_ACCOUNT=
PHRO_GMAIL_PERSONAL_ACCOUNT=

# Gmail Search Query (defaults to "in:inbox newer_than:7d" if unset)
GMAIL_QUERY=in:inbox newer_than:7d

# Twilio & Voice Gateway (Placeholders)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER_E164=+1XXXXXXXXXX
PHRO_OWNER_PHONE_E164=+1XXXXXXXXXX
PHRO_PUBLIC_BASE_URL=https://your-public-host.example.com
PHRO_PUBLIC_WSS_URL=wss://your-public-host.example.com
PHRO_VOICE_PORT=3100
