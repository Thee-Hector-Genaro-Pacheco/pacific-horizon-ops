# Anthropic API credentials
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5

# Gmail Profile Selector (options: business, personal; defaults to "business" if unset)
PHRO_GMAIL_PROFILE=business

# Expected Gmail Account Binding (Optional safety guard: normalised email address)
PHRO_GMAIL_BUSINESS_ACCOUNT=
PHRO_GMAIL_PERSONAL_ACCOUNT=

# Gmail Search Query (defaults to "in:inbox newer_than:7d" if unset)
GMAIL_QUERY=in:inbox newer_than:7d

# Twilio & Voice Gateway (Placeholders)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER_E164=+1XXXXXXXXXX
PHRO_OWNER_PHONE_E164=+1XXXXXXXXXX
PHRO_PUBLIC_BASE_URL=https://your-public-host.example.com
PHRO_PUBLIC_WSS_URL=wss://your-public-host.example.com
PHRO_VOICE_PORT=3100

# Photo Booth Analytics (read-only reporting API; server-side only, never commit the real key)
PHOTO_BOOTH_ANALYTICS_URL=https://cqlrzijqezowffoxeoxo.supabase.co/functions/v1/event-analytics
PHOTO_BOOTH_REPORTING_API_KEY=your_photo_booth_reporting_api_key_here
# Optional request timeout in milliseconds (defaults to 10000)
PHOTO_BOOTH_ANALYTICS_TIMEOUT_MS=10000

# Google Calendar (read-only). Uses the business Google account; run `npm run calendar:auth` once.
# IANA timezone for every local-time interpretation (defaults to America/Los_Angeles)
PHRO_TIMEZONE=America/Los_Angeles
# Calendar to read (defaults to "primary")
PHRO_CALENDAR_ID=primary
# Optional request timeout in milliseconds (defaults to 10000)
PHRO_CALENDAR_TIMEOUT_MS=10000

# Knowledge store (PHRO-AI-001): local Postgres + pgvector (docker-compose.knowledge.yml)
# PHRO_KNOWLEDGE_DATABASE_URL=postgres://phro:<password>@127.0.0.1:5435/phro_knowledge
PHRO_KNOWLEDGE_DATABASE_URL=
# Embeddings: "ollama" (default, local and free) or "none" (lexical only)
PHRO_EMBEDDINGS_PROVIDER=ollama
PHRO_OLLAMA_URL=http://127.0.0.1:11434
PHRO_EMBEDDINGS_MODEL=nomic-embed-text
# Optional: extra knowledge roots (path-delimited); ./knowledge is always allowed
PHRO_KNOWLEDGE_ROOTS=
